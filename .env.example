# signals-360 configuration
#
# Copy to .env and uncomment values to override config/base.conf defaults.
# devenv shell loads .env automatically (dotenv.enable = true).
# SecretSpec (secretspec.toml) uses the dotenv provider by default — the
# same .env can supply declared secrets (keytab paths, API keys).
# Prefer `secretspec run -- <cmd>` for secret-bearing jobs.
# See docs/current/src/operations/secrets.md

# ── Kerberos (REQUIRED — just bootstrap) ─────────────────────────
# No NOSASL path. Impala + Kudu use FQDN SPNs; clients never dial 127.0.0.1.
# SIGNALS_KRB_HOST=tinybox.dev.vista.zndx.org
# IMPALA_HS2_HOST=tinybox.dev.vista.zndx.org
# SIGNALS_KRB_USER_KEYTAB=.devenv/kdc/signals.keytab
# Realm/env are non-secret (devenv.nix): KRB5_REALM=DEV.VISTA.ZNDX.ORG
# Local kdc-init mints keytabs under .devenv/kdc/ via: just bootstrap

# ── Durable data root (devenv up data plane + just backup) ────────
# Lab default: /raid/signals  (kudu/ rustfs/ flink/ backups/ siblings)
# SIGNALS_DATA_ROOT=/raid/signals
# SIGNALS_KUDU_HOME=$SIGNALS_DATA_ROOT/kudu
# SIGNALS_RUSTFS_DATA_DIR=$SIGNALS_DATA_ROOT/rustfs
# RUSTFS_DATA_DIR=$SIGNALS_DATA_ROOT/rustfs
# SIGNALS_FLINK_DATA_DIR=$SIGNALS_DATA_ROOT/flink
# SIGNALS_BACKUP_DIR=$SIGNALS_DATA_ROOT/backups

# ── Infrastructure ────────────────────────────────────────────────
# SIGINT_IMPALA_HOST=tinybox.dev.vista.zndx.org
# SIGINT_IMPALA_PORT=21050
# SIGINT_ATLAS_URL=http://localhost:21010
# SIGINT_ATLAS_USER=admin
# SIGINT_ATLAS_PASSWORD=admin
# SIGINT_CLUSTER_NAME=signals
#
# Atlas HTTP + Marquez UI (devenv processes)
# Convention: MARQUEZ_WEB_PORT = SIGNALS_ATLAS_HTTP_PORT + 1 (defaults 21010/21011).
# SIGNALS_ATLAS_HTTP_PORT=21010
# MARQUEZ_WEB_PORT=21011
# SIGNALS_OL_API_HOST=127.0.0.1
# SIGNALS_OL_API_PORT=21010

# ── Classification ────────────────────────────────────────────────
# SIGINT_CLASSIFIER_TYPE=embedding
# SIGINT_CONFIDENCE_THRESHOLD=0.3
# SIGINT_NAME_MATCH_BOOST=true
# SIGINT_DRY_RUN=false

# ── Embedding model ──────────────────────────────────────────────
# SIGINT_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Embedding / HF caches — prefer shared RAID (do not duplicate under build/models):
#   HF_HOME=/raid/cache/huggingface
#   HF_HUB_CACHE=/raid/cache/rch/huggingface
#   SENTENCE_TRANSFORMERS_HOME=/raid/cache/sentence-transformers
#   SIGINT_EMBEDDING_CACHE_DIR=$SENTENCE_TRANSFORMERS_HOME
# SIGINT_DEVICE=auto
# SIGINT_BATCH_SIZE=32

# ── LLM classifier ───────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# SIGINT_LLM_MODEL=claude-opus-4-6
# CEREBRAS_API_KEY=csk-...

# ── Taxonomy ──────────────────────────────────────────────────────
# SIGINT_TAXONOMY=sigdg
# SIGINT_HIERARCHICAL=true

# ── SVM / SAGE / SHAP / GPU / ML ─────────────────────────────────
# SIGINT_SVM_MODEL_PATH=
# SIGINT_SAGE_PERMUTATIONS=512
# SIGINT_SHAP_ENABLED=true
# SIGINT_DEVICE=auto
# SIGINT_GPU_DEVICES=0
# SIGINT_ML_FOLDS=5
