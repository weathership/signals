# signals-360 configuration
#
# Copy to .env and uncomment values to override config/base.conf defaults.
# devenv shell loads .env automatically (dotenv.enable = true).
# SecretSpec (secretspec.toml) uses the dotenv provider by default — the
# same .env can supply declared secrets (keytab paths, API keys).
# Prefer `secretspec run -- <cmd>` for secret-bearing jobs.
# See docs/current/src/operations/secrets.md

# ── Kerberos / SecretSpec (paths only — never commit keytab bytes) ─
# Local kdc-init mints keytabs under .devenv/kdc/; set these only to override.
# Realm/env are non-secret (devenv.nix): KRB5_REALM=DEV.VISTA.ZNDX.ORG
# SIGNALS_KRB_USER_KEYTAB=.devenv/kdc/signals.keytab
# POSTGRES_KRB_KEYTAB=.devenv/kdc/postgres.keytab
# IMPALA_KRB_KEYTAB=.devenv/kdc/impala.keytab
# KUDU_KRB_KEYTAB=.devenv/kdc/kudu.keytab
# HTTP_KRB_KEYTAB=.devenv/kdc/http.keytab

# ── Infrastructure ────────────────────────────────────────────────
# SIGINT_IMPALA_HOST=127.0.0.1
# SIGINT_IMPALA_PORT=21050
# SIGINT_ATLAS_URL=http://localhost:21010
# SIGINT_ATLAS_USER=admin
# SIGINT_ATLAS_PASSWORD=admin
# SIGINT_CLUSTER_NAME=signals

# ── Classification ────────────────────────────────────────────────
# SIGINT_CLASSIFIER_TYPE=embedding
# SIGINT_CONFIDENCE_THRESHOLD=0.3
# SIGINT_NAME_MATCH_BOOST=true
# SIGINT_DRY_RUN=false

# ── Embedding model ──────────────────────────────────────────────
# SIGINT_EMBEDDING_MODEL=all-MiniLM-L6-v2
# SIGINT_MODEL_PATH=
# Embedding / HF caches — prefer shared RAID (do not duplicate under build/models):
#   HF_HOME=/raid/cache/huggingface
#   HF_HUB_CACHE=/raid/cache/rch/huggingface   # hub package; may differ from $HF_HOME/hub
#   SENTENCE_TRANSFORMERS_HOME=/raid/cache/sentence-transformers
#   SIGINT_EMBEDDING_CACHE_DIR=$SENTENCE_TRANSFORMERS_HOME
# SIGINT_EMBEDDING_CACHE_DIR=
# SIGINT_DEVICE=auto
# SIGINT_BATCH_SIZE=32

# ── LLM classifier ───────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# SIGINT_LLM_MODEL=claude-opus-4-6
# CEREBRAS_API_KEY=csk-...                  # Cerebras Cloud API key (for bootstrap)

# ── Taxonomy ──────────────────────────────────────────────────────
# SIGINT_TAXONOMY=sigdg
# SIGINT_HIERARCHICAL=true
# SIGINT_ANNOTATIONS_PATH=
# SIGINT_TAXONOMY_FILE=

# ── Vocabulary mapping ───────────────────────────────────────────
# SIGINT_VOCAB_MAPPING_ENABLED=false
# SIGINT_VOCAB_MAPPING_FILE=

# ── SVM classifier (5th DST evidence source) ─────────────────────
# Always active when model available — no enable flag.
# SIGINT_SVM_MODEL_PATH=
# SIGINT_SVM_DISCOUNT=0.20

# ── SAGE analysis ─────────────────────────────────────────────────
# SIGINT_SAGE_PERMUTATIONS=512

# ── SHAP item-wise explanations ──────────────────────────────────
# SIGINT_SHAP_ENABLED=true

# ── GPU acceleration ──────────────────────────────────────────────
# SIGINT_DEVICE=auto                    # auto | cuda | cpu
# SIGINT_GPU_DEVICES=0                  # CUDA device IDs (e.g., "0" or "0:1:2")
# Requires NVIDIA driver ≥570 for PyTorch 2.10+ (CUDA 12.8).
# Upgrade: sudo apt install nvidia-driver-570-open && sudo reboot

# ── CatBoost ML ───────────────────────────────────────────────────
# SIGINT_ML_FOLDS=5
# SIGINT_TRAIN_DIR=
# SIGINT_CONCAT_FEATURES=true
# SIGINT_AUTO_GENERATE=false
# SIGINT_VARIANTS_PER_CATEGORY=50
# SIGINT_SELF_TRAIN=false                 # Inject GT-labeled eval data into CatBoost training
# SIGINT_SELF_TRAIN_ROUNDS=1              # Iterative refinement rounds (1=direct GT injection)
# SIGINT_SELF_TRAIN_THRESHOLD=0.80        # Min CatBoost confidence for multi-round pseudo-labels

# ── Bootstrap agent ──────────────────────────────────────────────
# LLM outer loop for novel tables (no ground truth).
# SIGINT_BOOTSTRAP_MAX_ITERATIONS=5          # Max convergence iterations
# SIGINT_BOOTSTRAP_K_THRESHOLD=0.2           # DST conflict K threshold for LLM revisit
# SIGINT_BOOTSTRAP_COVERAGE_TARGET=0.95      # Target label coverage before stopping
# SIGINT_BOOTSTRAP_CONFIDENCE_FLOOR=0.5      # Min confidence for ML-only acceptance
# SIGINT_BOOTSTRAP_PROPAGATION_SIMILARITY=0.85  # Cosine sim threshold for label propagation
# SIGINT_BOOTSTRAP_MAX_TOTAL_LLM_CALLS=5000  # Budget cap on total LLM API calls
# SIGINT_BOOTSTRAP_COLUMNS_PER_CALL=50       # Columns per batch LLM call (GLM-4.7 200K ctx)
# SIGINT_BOOTSTRAP_OUTPUT=build/bootstrap_gt.json
# SIGINT_BOOTSTRAP_LLM_BACKEND=cerebras      # cerebras | anthropic | openai_compatible
# SIGINT_BOOTSTRAP_LLM_API_KEY=              # Override API key (default: CEREBRAS_API_KEY)
# SIGINT_BOOTSTRAP_LLM_BASE_URL=             # e.g. http://localhost:8000/v1 for vLLM
# SIGINT_BOOTSTRAP_LLM_MODEL=zai-glm-4.7          # or llama-3.3-70b, claude-opus-4-6
# SIGINT_BOOTSTRAP_LLM_DISCOUNT=0.10         # DST discount for LLM mass function

# ── Data paths ────────────────────────────────────────────────────
# SIGINT_DATA_DIR=
# SIGINT_INPUT_FORMAT=csv
# SIGINT_GROUND_TRUTH=
# SIGINT_OUTPUT=build/sigint_embeddings.parquet
