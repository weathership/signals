# Ansible inventory for Signals 360
# Generated by: devenv tasks run aws:inventory
# Manual template - fill in IPs from tofu output

[bastion]
bastion ansible_host=<BASTION_PUBLIC_IP> ansible_user=ubuntu

[control_plane]
cp-0 ansible_host=<CP_PRIVATE_IP_0> ansible_user=ubuntu

[workers]
worker-0 ansible_host=<WORKER_PRIVATE_IP_0> ansible_user=ubuntu
worker-1 ansible_host=<WORKER_PRIVATE_IP_1> ansible_user=ubuntu
worker-2 ansible_host=<WORKER_PRIVATE_IP_2> ansible_user=ubuntu
worker-3 ansible_host=<WORKER_PRIVATE_IP_3> ansible_user=ubuntu

[rke2:children]
control_plane
workers

[rke2:vars]
ansible_ssh_common_args=-o ProxyCommand="ssh -W %h:%p -i <SSH_KEY_PATH> ubuntu@<BASTION_PUBLIC_IP>"

[all:vars]
ansible_ssh_private_key_file=<SSH_KEY_PATH>
k8s_api_endpoint=<CP_PRIVATE_IP_0>
s3_bucket_name=<S3_BUCKET_NAME>
aws_region=us-east-1
