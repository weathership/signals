[Unit]
Description=Gaius federated engine (signals peer)
Documentation=file:///home/rch/local/src/wxs/signals/docs/current/src/operations/peer-integration.md
Documentation=file:///home/rch/local/src/zndx/gaius/docs/current/src/operations/peer-unit.md
PartOf=signals.target
After=signals-ready.service network-online.target
Wants=signals-ready.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# After ExecStop, reap anything still in this cgroup (not session leftovers —
# those are handled in systemd_stop.sh by cwd == Gaius checkout).
KillMode=control-group
User=rch
Group=rch
WorkingDirectory=/home/rch/local/src/zndx/gaius
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/rch/.nix-profile/bin
# Login-shell devenv uses $XDG_RUNTIME_DIR/devenv-<hash>. The unit uses a
# dedicated compose so start/stop never attach to a leftover session stack.
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=GAIUS_DEVENV_RUNTIME=/run/user/1001/gaius-systemd
# Pin contract port — devenv's allocator otherwise shifts to :5445.
Environment=PGPORT=5444
# Wrappers live in the Gaius tree; they block until Engine/Status on :50051.
ExecStart=/home/rch/local/src/zndx/gaius/scripts/systemd_start.sh
ExecStop=/home/rch/local/src/zndx/gaius/scripts/systemd_stop.sh
TimeoutStartSec=1200
TimeoutStopSec=300

[Install]
WantedBy=signals.target
