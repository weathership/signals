[Unit]
Description=Signals readiness oneshot (Gaius-style PASS/WARN/FAIL)
Documentation=file:///home/rch/local/src/wxs/signals/scripts/signals_ready.sh
PartOf=signals.target
After=signals.service
Requires=signals.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=rch
Group=rch
WorkingDirectory=/home/rch/local/src/wxs/signals
# Poll until critical plane is ready (includes Kudu + Metaflow)
ExecStart=/bin/bash -lc '\
  for i in $(seq 1 120); do \
    if just signals-ready; then exit 0; fi; \
    echo "signals-ready: waiting (attempt $i/120)…"; \
    sleep 10; \
  done; \
  echo "signals-ready: timed out" >&2; \
  exit 1'
TimeoutStartSec=1500

[Install]
WantedBy=signals.target
