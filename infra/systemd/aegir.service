[Unit]
Description=Aegir federated engine (signals peer)
Documentation=file:///home/rch/local/src/wxs/signals/docs/current/src/operations/peer-integration.md
Documentation=file:///home/rch/local/src/wxs/signals/docs/current/src/operations/peer-unit-spec.md
# Peer session must replace Exec* with aegir scripts/systemd_{start,stop}.sh:
#   - start capability engine on :50151 (not only just up stack-health)
#   - wait codegen Status project=aegir + enable gRPC reflection
#   - soft stop (GPU lease-safe)
PartOf=signals.target
After=signals-ready.service network-online.target
Wants=signals-ready.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=rch
Group=rch
WorkingDirectory=/home/rch/local/src/zndx/aegir
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/rch/.nix-profile/bin
# Temporary until peer wrappers land — DO NOT enable for production lattice
# until Exec* points at systemd_start/stop and lattice-ci --require aegir passes.
ExecStart=/bin/bash -lc 'just up 2>/dev/null || devenv up -d'
ExecStop=/bin/bash -lc 'just down 2>/dev/null || devenv processes down || true'
TimeoutStartSec=1200
TimeoutStopSec=300

[Install]
WantedBy=signals.target
