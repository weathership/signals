[Unit]
Description=Aegir federated engine (signals peer)
Documentation=file:///home/rch/local/src/wxs/signals/docs/current/src/operations/peer-integration.md
Documentation=file:///home/rch/local/src/zndx/aegir/docs/current/src/operations/peer-unit.md
PartOf=signals.target
After=signals-ready.service network-online.target
Wants=signals-ready.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=rch
Group=rch
WorkingDirectory=/home/rch/local/src/zndx/aegir
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/rch/.nix-profile/bin
# devenv runtime dir follows XDG_RUNTIME_DIR; unset under systemd it falls back
# to /tmp, invisible to a login-shell `devenv processes` (see signals.service).
Environment=XDG_RUNTIME_DIR=/run/user/1001
# Wrappers live in the Ægir tree; they block until Engine/Status on :50151
# (capability engine — not just up stack-health).
ExecStart=/home/rch/local/src/zndx/aegir/scripts/systemd_start.sh
ExecStop=/home/rch/local/src/zndx/aegir/scripts/systemd_stop.sh
TimeoutStartSec=1200
TimeoutStopSec=300

[Install]
WantedBy=signals.target
