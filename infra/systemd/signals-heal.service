[Unit]
Description=Signals group self-heal (re-kick failed foundation until verified healthy)
Documentation=file:///home/rch/local/src/wxs/signals/infra/systemd/README.md
# Runs as root (no User=) so it can systemctl reset-failed / start the group.
After=signals.target

[Service]
Type=oneshot
ExecStart=/home/rch/local/src/wxs/signals/scripts/systemd_heal.sh
