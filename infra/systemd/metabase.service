[Unit]
Description=Metabase external dashboard engine (AGPL — not part of ASL2 signals tree)
Documentation=file:///home/rch/local/src/agpl/metabase/README.engine.md
Documentation=file:///home/rch/local/src/wxs/signals/infra/systemd/README.md
PartOf=signals.target
After=signals-ready.service network-online.target
Wants=signals-ready.service network-online.target

# License: this unit only starts a process in an external AGPL checkout.
# Do not vendor Metabase sources or jars into weathership/signals.

[Service]
Type=oneshot
RemainAfterExit=yes
User=rch
Group=rch
WorkingDirectory=/home/rch/local/src/agpl/metabase
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/rch/.nix-profile/bin
# devenv runtime dir follows XDG_RUNTIME_DIR; unset under systemd it falls back
# to /tmp, invisible to a login-shell `devenv processes` (see signals.service).
Environment=XDG_RUNTIME_DIR=/run/user/1001
# Wrapper scripts live in the AGPL tree (WorkingDirectory); keep multiline
# shell out of the unit file (systemd rejects unbalanced quotes).
ExecStart=/home/rch/local/src/agpl/metabase/scripts/systemd_start.sh
ExecStop=/home/rch/local/src/agpl/metabase/scripts/systemd_stop.sh
TimeoutStartSec=1200
TimeoutStopSec=300

[Install]
WantedBy=signals.target
