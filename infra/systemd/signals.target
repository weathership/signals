[Unit]
Description=Signals project group (foundation + federated engines)
Documentation=file:///home/rch/local/src/wxs/signals/infra/systemd/README.md
Documentation=file:///home/rch/local/src/wxs/signals/config/platform/peer-contract.json
# Soft-pull foundation + readiness + engine + C2 + Polaris + post-start verify.
# Peers opt in via WantedBy=. Refresh = systemctl restart signals.target
# (complete stop then start; signals-refresh.service verifies every member).
Wants=signals.service signals-ready.service signals-engine.service signals-c2.service signals-polaris.service signals-refresh.service

[Install]
WantedBy=multi-user.target
