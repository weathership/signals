[Unit]
Description=Atelier federated engine (signals peer)
Documentation=file:///home/rch/local/src/wxs/signals/docs/current/src/operations/peer-integration.md
Documentation=file:///home/rch/local/src/zndx/atelier/docs/current/src/operations/peer-unit.md
# Lattice engine on :50251 only — not product servicer :50071.
PartOf=signals.target
After=signals-ready.service network-online.target
Wants=signals-ready.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=rch
Group=rch
WorkingDirectory=/home/rch/local/src/zndx/atelier
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/rch/.nix-profile/bin
# Same runtime a login-shell `devenv processes` uses. Do not pin a
# dedicated DEVENV_RUNTIME — that splits systemd from devenv.
Environment=XDG_RUNTIME_DIR=/run/user/1001
# Wrappers live in the Atelier tree; block until Engine/Status on :50251.
ExecStart=/home/rch/local/src/zndx/atelier/scripts/systemd_start.sh
ExecStop=/home/rch/local/src/zndx/atelier/scripts/systemd_stop.sh
TimeoutStartSec=1200
TimeoutStopSec=300

[Install]
WantedBy=signals.target
