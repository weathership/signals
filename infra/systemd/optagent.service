[Unit]
Description=Optagent federated engine (signals peer)
Documentation=file:///home/rch/local/src/wxs/signals/docs/current/src/operations/peer-integration.md
Documentation=file:///home/rch/local/src/zndx/optagent/docs/architecture.md
# Lattice engine :50851, product UI :9892, Postgres :5599.
PartOf=signals.target
After=signals-ready.service network-online.target
Wants=signals-ready.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=rch
Group=rch
WorkingDirectory=/home/rch/local/src/zndx/optagent
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/rch/.nix-profile/bin
Environment=XDG_RUNTIME_DIR=/run/user/1001
ExecStart=/home/rch/local/src/zndx/optagent/scripts/systemd_start.sh
ExecStop=/home/rch/local/src/zndx/optagent/scripts/systemd_stop.sh
TimeoutStartSec=1200
TimeoutStopSec=300

[Install]
WantedBy=signals.target
