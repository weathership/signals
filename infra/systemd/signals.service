[Unit]
Description=Signals foundation (devenv critical plane)
Documentation=file:///home/rch/local/src/wxs/signals/docs/current/src/architecture/stack-critical-plane.md
PartOf=signals.target
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=rch
Group=rch
WorkingDirectory=/home/rch/local/src/wxs/signals
# System-wide just (/usr/local/bin) is required — not only devenv/nix PATH.
# Login shell still loads direnv/devenv for the rest of the toolchain.
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/rch/.nix-profile/bin
# Idempotent: already-ready stack (manual devenv) does not fail the unit
ExecStart=/home/rch/local/src/wxs/signals/scripts/systemd_foundation_start.sh
ExecStop=/home/rch/local/src/wxs/signals/scripts/systemd_foundation_stop.sh
TimeoutStartSec=900
TimeoutStopSec=300

[Install]
WantedBy=signals.target
